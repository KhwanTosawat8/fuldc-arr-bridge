# --- FulDC++ Web API ---------------------------------------------------------
# On the same Windows PC as FulDC++ (Docker Desktop): keep host.docker.internal.
# On another machine: use the LAN IP, e.g. http://192.168.0.22:5600
FULDC_URL=http://host.docker.internal:5600
FULDC_USER=admin
FULDC_PASS=change-me

# --- Where downloads go (a Windows path, as FulDC++ sees it) ------------------
# REQUIRED: set this to YOUR DC share root. It's whatever drive/folder your
# FulDC++ shares from - e.g. S:\dc, D:\Media, E:\Shares\DC ...
#   movies  -> DC_ROOT\movies\
#   series  -> DC_ROOT\series\<Show>\S<NN>\
DC_ROOT=S:\dc

# Optional: override the movie / TV folders directly (full Windows paths) if
# your layout isn't <root>\movies and <root>\series. Leave blank to use DC_ROOT.
#MOVIES_DIR=
#SERIES_DIR=

# 1 = only movies, 0 = movies + TV
MOVIES_ONLY=0

# Optional quality filter, e.g. 1080p. Movies: only that quality is grabbed.
# TV: baked into the %[inc] episode monitor. Blank = any quality.
QUALITY=

# --- Webhook security --------------------------------------------------------
# Anyone who can reach port 8080 can queue downloads on your machine. Set a
# random string here and append it to the Seerr webhook URL:
#   http://<host>:8080/?token=<value>
# Leave blank only if the port is strictly LAN-internal.
#WEBHOOK_TOKEN=

# --- Optional: refresh your media server right after a download --------------
# plex | jellyfin | webhook | none  (most servers rescan periodically anyway)
MEDIASERVER=none
#PLEX_URL=http://192.168.0.22:32400
#PLEX_TOKEN=
#PLEX_MOVIES_SECTION=Movies
#PLEX_SERIES_SECTION=TV Shows
#JELLYFIN_URL=http://192.168.0.22:8096
#JELLYFIN_TOKEN=
#NOTIFY_WEBHOOK=

# --- EXPERIMENTAL: Radarr/Sonarr integration (docker compose --profile arr) ---
# REQUIRED with --profile arr: the arr server refuses to start without it.
# Use the same value as the indexer API key in Radarr/Sonarr.
#TORZNAB_APIKEY=changeme
# Credentials for the qBittorrent-compatible download client (same values go in
# the Radarr/Sonarr download-client config). Blank = no authentication.
#QBIT_USER=admin
#QBIT_PASS=
